# ==============================================================================
# SRM Campus Directions App — Environment Variables Template
# When hosting on Render.com, add these variables in your Dashboard -> Environment:
# ==============================================================================

# 1. Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://whfcwfxygvleqgvarmte.supabase.co

# 2. Your Supabase Publishable / Anon API Key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 3. Your production app URL on Render (used for generating campus QR codes & canonical links)
NEXT_PUBLIC_APP_URL=https://srm-directions.onrender.com
